@startuml sd_02a parkhaus
!include tools/style.puml

actor Kunde as K
boundary "Kassenautomat" as Automat
control "TarifRechner" as Rechner
entity "ParkTicket" as Ticket
boundary "ZahlungsGateway" as Gateway

' 1. Ticket einstecken
K -> Automat : steckeTicketEin(ticketId)
activate Automat

Automat -> Rechner : berechneParkgebuehr(ticketId)
activate Rechner

Rechner -> Ticket : getEinfahrtszeit()
activate Ticket
Ticket --> Rechner : einfahrtszeit
deactivate Ticket

Rechner -> Rechner : kalkuliereTarif(dauer)
Rechner --> Automat : betrag
deactivate Rechner

Automat --> K : zeigeBetrag(betrag)

' 2. Bezahlung mit Karte
K -> Automat : halteKarteVor()

Automat -> Gateway : autorisiereZahlung(betrag, kartenDaten)
activate Gateway

Gateway --> Automat : statusOK
deactivate Gateway

Automat -> Ticket : markiereAlsBezahlt()
activate Ticket
Ticket --> Automat : quittiert
deactivate Ticket

Automat --> K : gebeTicketAus()

' 3. Beleg anfordern und drucken (regulärer Ablauf)
K -> Automat : fordereBelegAn()
Automat --> K : druckeQuittung()

deactivate Automat

@enduml

/'
============================================================
BCE-ENTWURFSMUSTER (Entity-Control-Boundary / Jacobson)
============================================================
* actor (Strichmännchen):
  - Menschlicher Nutzer oder externe Rolle außerhalb des Systems
  - Stößt den Ablauf an oder interagiert mit dem System

* boundary (Schnittstelle / Grenze):
  - Vermittelt zwischen Außenwelt und System (GUI, API, Hardware)
  - Nimmt Eingaben entgegen und leitet Ausgaben weiter

* control (Steuerung / Geschäftslogik):
  - Das „Gehirn“ des Ablaufs (Services, Controller, Rechenlogik)
  - Koordiniert Prozesse und führt Berechnungen durch

* entity (Datenobjekt / Zustandsträger):
  - Reine Fach- und Geschäftsdaten (Model, DB-Entität)
  - Speichert Zustand und Attribute, enthält keine Ablauflogik
============================================================
'/